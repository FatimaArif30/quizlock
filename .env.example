# ---- QuizLock front-end environment ----
# Copy this file to ".env" and paste your real values.
# Get these two from your Supabase project: Settings -> API

VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# ---- Server-side secrets (NOT used by the front-end) ----
# These go into Supabase Edge Function secrets, not this file.
# See README section 5. Listed here only so you know what you need:
#   RESEND_API_KEY   -> from https://resend.com  (Settings -> API Keys)
#   EMAIL_FROM       -> e.g. "QuizLock <onboarding@resend.dev>"
